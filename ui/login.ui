     <property name="styleSheet">
      <string notr="true">
/* Fondo con opacidad y esquinas redondeadas para dar forma irregular */
QFrame#frame_main{
  background: rgba(255,255,255,230);
  border-radius: 26px;
  border: 1px solid rgba(0,0,0,0.06);
}
/* Inputs y botones */
QLineEdit{
  min-height:36px;
  border:1px solid rgba(0,0,0,0.08);
  border-radius:8px;
  padding-left:10px;
  padding-right:10px;
  font-size:14px;
}
QPushButton{
  min-height:40px;
  border-radius:10px;
  font-weight:600;
}
/* Primary button */
QPushButton#btn_login{
  background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(34,150,243,255), stop:1 rgba(30,120,220,255));
  color: white;
  border: none;
}
/* Secondary / link style */
QPushButton#btn_generate{
  background: transparent;
  color: rgba(30,120,220,255);
  border: none;
  text-decoration: underline;
  font-weight: 600;
}
/* Close button */
QPushButton#btn_close{
  background: transparent;
  border: none;
  font-size: 18px;
  font-weight: 700;
}
